{
  "name": "star-soccer-website",
  "private": true,
  "scripts": {
    "build": "node scripts/build-css.cjs",
    "build:search": "node scripts/build-search-data.cjs",
    "build:coach": "node private-attendance/cloudflare/build-assets.mjs",
    "test": "node private-attendance/cloudflare/build-assets.mjs && node --test tests/*.test.cjs",
    "attendance:demo": "node private-attendance/demo.mjs",
    "test:attendance": "node --test tests/attendance-*.test.cjs",
    "test:attendance:browser": "node tests/attendance-ui.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "lightningcss": "1.33.0",
    "playwright": "1.64.1",
    "purgecss": "8.0.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "jose": "6.2.1"
  }
}
